module ml.webnn.mojom;

import "mojo/public/mojom/base/shared_memory.mojom";

// Enumeration for every distinct operator, regardless of how they may be
// grouped together in the mojom messages. There should be a 1:1 mapping to
// each OperatorKind::MLOperator::OperatorKind in ml_operator.h, and every
// callable operator function in ml_graph_builder.idl should have an entry.
// Note the OperationInfo::Tag enumerations are distinct and are subject to
// message grouping, such as combining multiple elementwise binary messages
// into a single struct.
[Stable, Extensible]
enum OperatorType {
  [Default] kUnknown = 0, // Used to throw exception for unsupported types in blink.

  kClamp,
  kConv2d,
  kGemm,

  // ElementWiseBinary operations
  kAdd,
  kSub,
  kMul,
  kDiv,
  kMax,
  kMin,
  kPow,

  // Elementwise logical binary operations
  kEqual,
  kGreater,
  kLesser,

  kHardSwish,
  kAveragePool2d,
  kMaxPool2d,
  kRelu,
  kReshape,
  kResample2d,
  kSoftmax,
  kSigmoid,

  // NEWOPS::: New prototype operators added for Stable diffusion 1.5.

  kMatmul, // Handled by GEMM.

  // Shape modification operations.
  kShape,
  kSqueeze,
  kUnsqueeze,
  kConcat,
  kSlice,
  kTranspose,
  kPad,
  kExpand, // like ONNX Expand or ConstantOfShape, broadcasts
  kGather,
  kFlattenTo2d,

  // ElementWiseUnary operations
  kIdentity,
  kExp,
  kSqrt,
  kSin,
  kCos,
  kTan,
  kErf,

  // Reduction operations
  kReduceL2,
  kReduceMean,
  kReduceSum,

  // Miscellaneous
  kArgMax,
  kArgMin,
  kCast,
  kInstanceNormalization,
  kFillSequence, // ONNX Range
  kTriangularMatrix,
  kElementWiseIf, // ONNX Where
};

// Represents the element data type of a tensor, or `MLOperandType`.
[Stable, Extensible]
enum OperandType {
  [Default] kFloat32,
  kFloat16,
  kInt32,
  kUint32,
  kInt8,
  kUint8,
};

// Represents the `MLOperandDescriptor` which describes not only input and
// constant operand, but also output node.
[Stable]
struct OperandDescriptor {
  // The type of the operand.
  OperandType data_type@0;
  // The dimensions of the operand.
  array<uint32> dimensions@1;
};

// Represents the `MLClampOptions`.
[Stable]
struct ClampOptions {
  // Specifies the minimum value of the range.
  float minValue@0;
  // Specifies the maximum value of the range.
  float maxValue@1;
};

// Corresponds to `MLOperand clamp(MLOperand input, MLClampOptions options)`
// function in `MLGraphBuilder`. The input `MLOperand` is mapping to the
// struct's input index, the return `MLOperand` is mapping to the struct's
// output index. `minValue` and `maxValue` are mapping to `MLClampOptions`.
[Stable]
struct Clamp {
  // The index of input operand in the model's operand array.
  uint64 input_index@0;
  // MLClampOptions is mapping to ClampOptions.
  ClampOptions options@1;
  // The index of output operand in the model's operand array.
  uint64 output_index@2;
};

// Represents the `MLInputOperandLayout` that specifies the layout format of
// the input tensor. N is the batch, C is input channels, H is height and W is
// the width of the tensor.
[Stable, Extensible]
enum InputOperandLayout { [Default] kNchw, kNhwc };

// Represents the `MLConv2dFilterOperandLayout` that specifies the layout format
// of filter tensor. O is the output channel count, i is input count / groups, H
// is height and W is the width of the tensor.
[Stable, Extensible]
enum Conv2dFilterOperandLayout { [Default] kOihw, kHwio, kOhwi, kIhwo };

// Represents the `MLAutoPad`. `Explicit` means that the values in the
// options.padding array should be used for input padding, with `SameUpper`
// and `SameLower` options, the padding values are automatically computed.
[Stable, Extensible]
enum AutoPad { [Default] kExplicit, kSameUpper, kSameLower };

////////////////////////////////////////////////////////////////////////////////
// NEWOPS::: New enums go here.

[Stable, Extensible]
enum TriangularPart { [Default] kUpper, kLower };

[Stable, Extensible]
enum PaddingMode { [Default] kConstant, kEdge, kReflection, kSymmetric };

[Stable, Extensible]
enum InterpolationMode { [Default] kNearestNeighbor, kLinear };
// END NEWOPS:::
////////////////////////////////////////////////////////////////////////////////

// Represents the `MLConv2dOptions`.
[Stable]
struct Conv2dOptions {
  // The additional rows and columns added to the beginning and ending of each
  // spatial dimension of input.
  array<uint32> padding@0;
  // The stride of the sliding window for each spatial dimension of input.
  array<uint32> strides@1;
  // The dilation factor for each spatial dimension of input.
  array<uint32> dilations@2;
  // The automatic input padding options.
  AutoPad auto_pad@3 = AutoPad.kExplicit;
  // The number of groups that input channels and output channels are divided
  // into.
  uint32 groups@4 = 1;
  // The layout format of the input.
  InputOperandLayout inputLayout@5 = InputOperandLayout.kNchw;
  // The layout format of the filter.
  Conv2dFilterOperandLayout filterLayout@6 = Conv2dFilterOperandLayout.kOihw;
  // The largest possible value for type uint64 identify the option index with
  // std::numeric_limits<uint64>::max().
  // The index of bias operand that is additional 1-D tensor with the
  // shape of [output_channels] whose values are to be added to the convolution
  // result.
  uint64 bias_index@7;
  //The optional activation function that immediately follows the convolution
  // operation.
  OperationInfo? activation@8;
};

// Corresponds to `MLOperand conv2d(MLOperand input, MLOperand filter,
// MLConv2dOptions options)` operation in `MLGraphBuilder`. The input
// `MLOperand` is mapping to the struct's input index, the filter `MLOperand` is
// mapping to the struct's filter index, the return `MLOperand` is mapping to
// the struct's output index.
[Stable]
struct Conv2d {
  // The index of input operand in the model's operand array.
  uint64 input_index@0;
  // The index of filter operand in the model's operand array.
  uint64 filter_index@1;
  // MLConv2dOptions is mapping to Conv2dOptions.
  Conv2dOptions options@2;
  // The index of output operand in the model's operand array.
  uint64 output_index@3;
};

// Element-wise unary operators:
// - identity: return same output as input.
// - abs: Compute the absolute value of the input tensor, element-wise.
// - ceil: Compute the ceiling of the input tensor, element-wise.
// - cos: Compute the cosine of the input tensor, element-wise.
// - exp: Compute the exponential of the input tensor, element-wise.
// - erf: Compute the exponential of the input tensor, element-wise.
// - floor: Compute the floor of the input tensor, element-wise.
// - log: Compute the natural logarithm of the input tensor, element-wise.
// - neg: Compute the numerical negative value of the input tensor, element-wise.
// - sin: Compute the sine of the input tensor, element-wise.
// - sqrt: Compute the square root of the input tensor, element-wise.
// - tan: Compute the tangent of the input tensor, element-wise.
//
[Stable]
struct ElementWiseUnary  {
  OperatorType operator_type@0; // The type of unary operation.
  uint64 input_index@1; // The index of a operand in the model's operand array.
  uint64 output_index@2; // The index of output operand in the model's operand array.
};

// Element-wise binary operators:
// - add: Add the values of the two input tensors, element-wise.
// - sub: Subtract the values of the second input tensor from the values of the first input tensor, element-wise.
// - mul: Multiply the values of the two input tensors, element-wise.
// - div: Divide the values of the first input tensor with the values of the second tensor, element-wise.
// - max: Select the greater values of the two input tensors, element-wise.
// - min: Select the lesser values of the two input tensors, element-wise.
// - pow: Compute the values of the values of the first input tensor to the power of the values of the second input tensor, element-wise.
//
// The `OperatorType` specifies the specific one. e.g. Add corresponds to
// `MLOperand add(MLOperand a, MLOperand b)` function in `MLGraphBuilder`.
// The 'a' `MLOperand` is mapped to the struct's a index, and the 'b'
// `MLOperand` is mapped to the struct's b index, while the returned
// `MLOperand` is mapped to the struct's output index.
[Stable]
struct ElementWiseBinary  {
  // The type of binary operation.
  OperatorType operator_type@0;
  // The index of a operand in the model's operand array.
  uint64 a_index@1;
  // The index of b operand in the model's operand array.
  uint64 b_index@2;
  // The index of output operand in the model's operand array.
  uint64 output_index@3;
};

// Represents the `MLGemmOptions`.
// Also handles MatMul.
[Stable]
struct GemmOptions {
  // The largest possible value for type uint64 identifies the empty optional index with
  // std::numeric_limits<uint64>::max().
  uint64 c_index@0;
  // The scalar multiplier for the first input.
  float alpha@1 = 1.0;
  // The scalar multiplier for the third input.
  float beta@2 = 1.0;
  // If the first input should be transposed prior to calculating the output.
  bool a_transpose@3 = false;
  // If the second  input should be transposed.
  bool b_transpose@4 = false;
};

// Corresponds to `MLOperand gemm(MLOperand a, MLOperand b, MLGemmOptions
// options)` function in `MLGraphBuilder`. The a `MLOperand` is mapping to the
// struct's a index, The b `MLOperand` is mapping to the struct's b index, the
// return `MLOperand` is mapping to the struct's output index.
[Stable]
struct Gemm {
  // The index of a operand in the model's operand array.
  uint64 a_index@0;
  // The index of b operand in the model's operand array.
  uint64 b_index@1;
  // MLGemmOptions is mapping to GemmOptions.
  GemmOptions options@2;
  // The index of output operand in the model's operand array.
  uint64 output_index@3;
};

// Represents the `MLPool2dType`, the `kUnknown` is used to throw exception for
// unsupported type in blink.
[Stable, Extensible]
enum Pool2dType {
  [Default] kUnknown = 0,
  kAveragePool2d,
  kMaxPool2d,
  kL2Pool2d
};

[Stable, Extensible]
enum RoundingType { [Default] kFloor, kCeil };

// Represents the `MLPool2dOptions`.
[Stable]
struct Pool2dOptions {
  // The dimensions of the sliding window.
  array<uint32> window_dimensions@0;
  // The additional rows and columns added to the beginning and ending of each
  // spatial dimension of input.
  array<uint32> padding@1;
  // The stride of the sliding window for each spatial dimension of input.
  array<uint32> strides@2;
  // The dilation factor for each spatial dimension of input.
  array<uint32> dilations@3;
  // The automatic input padding options.
  AutoPad auto_pad@4 = AutoPad.kExplicit;
  // The layout format of the input.
  InputOperandLayout layout@5 = InputOperandLayout.kNchw;
  // The rounding function used to compute the output shape.
  RoundingType rounding_type@6 = RoundingType.kFloor;
  // The sizes of the two spatial dimensions of the output tensor.
  array<uint32> output_sizes@7;
};

// Add a mean, L2 norm, or max reduction operation defined in `Pool2dType`
// across all the elements within the moving window over the input tensor.
// Corresponds to `MLOperand pool2d(MLOperand input, MLPool2dOptions options)`
// function in `MLGraphBuilder`. The input `MLOperand` is mapping to the
// struct's input index, the return `MLOperand` is mapping to the struct's
// output index.
[Stable]
struct Pool2d {
  // The type of pool2d operation.
  Pool2dType type@0;
  // The index of input operand in the model's operand array.
  uint64 input_index@1;
  // MLPool2dOptions is mapping to Pool2dOptions.
  Pool2dOptions options@2;
  // The index of output operand in the model's operand array.
  uint64 output_index@3;
};

// Corresponds to `MLOperand relu(MLOperand x)` that compute the rectified
// linear function of the input tensor.
// The input `MLOperand` is mapping to the struct's input index, the return
// `MLOperand` is mapping to the struct's output index.
[Stable]
struct Relu {
  // The index of input operand in the model's operand array.
  uint64 input_index@0;
  // The index of output operand in the model's operand array.
  uint64 output_index@1;
};

// Corresponds to `MLOperand reshape(MLOperand input, sequence<long> shape)`
// function in `MLGraphBuilder`.The input `MLOperand` is mapping to the struct's
// input index, the `shape` is set with the dimensions of output OperandDesc.
// the return `MLOperand` is mapping to the struct's output index.
[Stable]
struct Reshape {
  // The index of input operand in the model's operand array.
  uint64 input_index@0;
  // The index of output operand in the model's operand array.
  uint64 output_index@1;
};

// Corresponds to `MLOperand softmax(MLOperand x)` that compute the softmax
// values of the 2-D input tensor along axis 1.
// The input `MLOperand` is mapping to the struct's input index, the return
// `MLOperand` is mapping to the struct's output index.
[Stable]
struct Softmax {
  // The index of input operand in the model's operand array.
  uint64 input_index@0;
  // The index of output operand in the model's operand array.
  uint64 output_index@1;
};

