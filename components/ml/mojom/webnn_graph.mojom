// Shape modification operations.

[Stable]
struct Shape {
  uint64 input_index@0;     // Index of input operand in model's operand array.
  uint64 output_index@1;    // Index of output operand in model's operand array.
};

[Stable]
struct SqueezeOptions {
  array<uint32> axes@0;
};

[Stable]
struct Squeeze {
  uint64 input_index@0;     // Index of input operand in model's operand array.
  SqueezeOptions squeeze_options@1;
  uint64 output_index@2;    // Index of output operand in model's operand array.
};

[Stable]
struct Unsqueeze {
  uint64 input_index@0;     // Index of input operand in model's operand array.
  SqueezeOptions squeeze_options@1;
  uint64 output_index@2;    // Index of output operand in model's operand array.
};

[Stable]
struct Concat {
  array<uint64> input_indices@0;
  uint32 axis@1;
  uint64 output_index@2;    // Index of output operand in model's operand array.
};

[Stable]
struct SliceOptions {
  array<uint32> axes@0;
};

[Stable]
struct Slice {
  uint64 input_index@0;
  array<int32> starts@1;
  array<int32> sizes@2;
  SliceOptions options@3;
  uint64 output_index@4;    // Index of output operand in model's operand array.
};

[Stable]
struct Transpose {
  uint64 input_index@0;
  array<uint32> permutation@1;
  uint64 output_index@2;    // Index of output operand in model's operand array.
};

[Stable]
struct PadOptions {
  PaddingMode mode@0 = PaddingMode.kConstant;
  float value@1;
};

[Stable]
struct Pad {
  uint64 input_index@0;
  array<uint32> beginningPadding@1;
  array<uint32> endingPadding@2;
  PadOptions options@3;
  uint64 output_index@4;    // Index of output operand in model's operand array.
};

[Stable]
struct Expand {
  uint64 input_index@0;
  array<uint32> new_shape@1;
  uint64 output_index@2;    // Index of output operand in model's operand array.
};

[Stable]
struct Gather {
  uint64 input_index@0;
  uint64 indices_index@1;
  uint32 axis@2;
  uint64 output_index@3;    // Index of output operand in model's operand array.
};

[Stable]
struct FlattenTo2d {
  uint64 input_index@0;
  uint32 axis@1;
  uint64 output_index@2;    // Index of output operand in model's operand array.
};

// Reduction operations

[Stable]
struct ReduceOptions {
  array<uint32> axes@0; // = null; TODO: Can this be optional?
  bool keep_dimensions@1 = false;
};

[Stable]
struct reduceL1 {
  uint64 input_index@0;
  ReduceOptions options@1;
  uint64 output_index@2;    // Index of output operand in model's operand array.
};

[Stable]
struct ReduceL2 {
  uint64 input_index@0;
  ReduceOptions options@1;
  uint64 output_index@2;    // Index of output operand in model's operand array.
};

[Stable]
struct ReduceLogSum {
  uint64 input_index@0;
  ReduceOptions options@1;
  uint64 output_index@2;    // Index of output operand in model's operand array.
};

[Stable]
struct ReduceLogSumExp {
  uint64 input_index@0;
  ReduceOptions options@1;
  uint64 output_index@2;    // Index of output operand in model's operand array.
};

[Stable]
struct ReduceMax {
  uint64 input_index@0;
  ReduceOptions options@1;
  uint64 output_index@2;    // Index of output operand in model's operand array.
};

[Stable]
struct ReduceMean {
  uint64 input_index@0;
  ReduceOptions options@1;
  uint64 output_index@2;    // Index of output operand in model's operand array.
};

[Stable]
struct ReduceMin {
  uint64 input_index@0;
  ReduceOptions options@1;
  uint64 output_index@2;    // Index of output operand in model's operand array.
};

[Stable]
struct ReduceProduct {
  uint64 input_index@0;
  ReduceOptions options@1;
  uint64 output_index@2;    // Index of output operand in model's operand array.
};

[Stable]
struct ReduceSum {
  uint64 input_index@0;
  ReduceOptions options@1;
  uint64 output_index@2;    // Index of output operand in model's operand array.
};

[Stable]
struct ReduceSumSquare {
  uint64 input_index@0;
  ReduceOptions options@1;
  uint64 output_index@2;    // Index of output operand in model's operand array.
};

[Stable]
struct ArgMinMaxOptions {
  uint32 axis@0 = 0;
  bool keep_dimensions@1 = false;
};

[Stable]
struct ArgMax {
  uint64 input_index@0;
  ArgMinMaxOptions options@1;
  uint64 output_index@2;    // Index of output operand in model's operand array.
};

[Stable]
struct ArgMin {
  uint64 input_index@0;
  ArgMinMaxOptions options@1;
  uint64 output_index@2;    // Index of output operand in model's operand array.
};

[Stable]
struct Cast {
  uint64 input_index@0;
  OperandType data_type@1 = OperandType.kFloat32;
  uint64 output_index@2;    // Index of output operand in model's operand array.
};

[Stable]
struct InstanceNormalizationOptions {
  uint64 scale_index@0;
  uint64 bias_index@1;
  float epsilon@2;
  InputOperandLayout layout@3 = InputOperandLayout.kNchw;
};

[Stable]
struct InstanceNormalization {
  uint64 input_index@0;
  InstanceNormalizationOptions options@1;
  uint64 output_index@2;    // Index of output operand in model's operand array.
};

[Stable]
struct FillSequenceOptions {
  float start@0;
  float limit@1; // Stop at this value (end-exclusive).
  float step@2;
};

[Stable]
struct FillSequence {
  uint64 input_index@0;
  FillSequenceOptions options@1;
  uint64 output_index@2;    // Index of output operand in model's operand array.
};

[Stable]
struct TriangularMatrixOptions {
  TriangularPart triangular_part@0 = TriangularPart.kUpper;
  int32 diagonal_delta@1;
};

[Stable]
struct TriangularMatrix {
  uint64 input_index@0;
  TriangularMatrixOptions options@1;
  uint64 output_index@2;    // Index of output operand in model's operand array.
};

[Stable]
struct ElementWiseIf {
  uint64 condition_index@0;
  uint64 true_value_index@1;    // Index of operand model's operand array
  uint64 false_value_index@2;   // Index of operand model's operand array
  uint64 output_index@3;        // Index of output operand in model's operand array.
};

// Represents `MLResample2DOptions`.
[Stable]
struct Resample2DOptions {
  InterpolationMode mode@0 = InterpolationMode.kNearestNeighbor;
  array<float> scales@1;
  array<uint32> sizes@2;
  array<uint32> axes@3;
};

[Stable]
struct Resample2D {
  uint64 input_index@0;
  Resample2DOptions options@1;
  uint64 output_index@2;        // Index of output operand in model's operand array.
};

// Describe the information of inputs / outputs data in shared buffer.
[Stable]
struct MemoryInfo {
  // The offset of buffer.
  uint64 byte_offset@0;
  // The length of buffer.
  uint64 byte_length@1;
};

// Represents the `MLNamedArrayBufferViews`.
[Stable]
struct NamedResources  {
  map<string, MemoryInfo> resources@0;
  mojo_base.mojom.ReadOnlySharedMemoryRegion shared_memory@1;
};

// Represents the operations defined in `MLGraphBuilder`, the information of the
// operation describe the functional semantics.
[Stable]
union OperationInfo {
  // Keep the order as the same as build methods of `MLGraphBuilder`.
  Clamp clamp;
  Conv2d conv2d;
  ElementWiseUnary element_wise_unary;
  ElementWiseBinary element_wise_binary;
  Gemm gemm;
  Pool2d pool2d;
  Relu relu;
  Reshape reshape;
  Softmax softmax;

  //////////////////////////////////////////////////////////////////////
  // NEWOPS::: New operators go here.
  Shape shape;
  Squeeze squeeze;
  Unsqueeze unsqueeze;
  Concat concat;
  Slice slice;
  Transpose transpose;
  Pad pad;
  Expand expand;
  Gather gather;
  FlattenTo2d flatten_to_2d;
  ReduceL2 reduce_l2;
  ReduceSum reduce_sum;
  ReduceMean reduce_mean;
  Resample2D resample2d;
  ArgMax arg_max;
  ArgMin arg_min;
  Cast cast;
  InstanceNormalization instance_normalization;
  FillSequence fill_sequence;
  TriangularMatrix triangular_matrix;
  ElementWiseIf element_wise_if;
};

// Represents the input and output operands in the model.
[Stable]
struct NamedOperand {
  // The name of input / output operand.
  string name;
  // The index of input / output in the model's operands array.
  uint64 index;
};

// Represents the constant operands in the model.
[Stable]
struct ConstantsInfo {
  // The key is index of model's operands array to identify constant operand.
  map<uint64, MemoryInfo> memory_info@0;
  mojo_base.mojom.ReadOnlySharedMemoryRegion shared_memory@1;
};

// The model information.
[Stable]
struct ModelInfo {
  // All operands in the model.
  array<OperandDescriptor> operands@0;
  // All inputs in the model.
  array<NamedOperand> inputs@1;
  // All outputs in the models.
  array<NamedOperand> outputs@2;
  // All operations in the model.
  array<OperationInfo> operations@3;
  // The constants data in shared memory.
  ConstantsInfo? constants;
};

// Used by `BuildGraph()` of interface Graph.
[Stable, Extensible]
enum BuildResult {
  [Default] kOk,
  kUnknownError,
};

// Used by `Compute()` of interface Graph.
[Stable, Extensible]
enum ComputeResult {
  [Default] kOk,
  kUnknownError,
};

// Corresponds to the `MLGraph` object in the WebIDL definition. The user can
// use its `Compute` interface to do inferences.
[Stable]
interface Graph {
  // Compile the `MLGraphBuild` state up to the specified output operands into
  // a compiled graph according to the type of `MLContext` that creates it.
  // `result` is the status of building graph.
  [Sync]
  Build@0(ModelInfo model_info) => (BuildResult result);

  // Carries out the computational workload of a compiled graph.
  // `named_inputs` is the resources of inputs with shared memory,
  // `named_outputs` is the result of inference which return to renderer process
  // with shared memory.
  [Sync]
  Compute@1(NamedResources named_inputs)
      => (ComputeResult result, NamedResources? named_outputs);
};
