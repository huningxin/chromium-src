import("//third_party/blink/renderer/modules/ml/webnn/features.gni")
import("//third_party/blink/renderer/modules/modules.gni")

config("ml_flags") {
  if (build_webnn_with_xnnpack) {
    defines = [ "BUILD_WEBNN_WITH_XNNPACK" ]
  }
}

blink_modules_sources("webnn") {
  sources = [
    "ml_graph.cc",
    "ml_graph.h",
    "ml_graph_builder.cc",
    "ml_graph_builder.h",
    "ml_operand.cc",
    "ml_operand.h",
    "ml_operator.cc",
    "ml_operator.h",
  ]
  deps = [ "//third_party/blink/renderer/modules/ml" ]

  configs += [ ":ml_flags" ]

  if (build_webnn_with_xnnpack) {
    sources += [
      "ml_graph_xnnpack.cc",
      "ml_graph_xnnpack.h",
    ]

    deps += [
      "//third_party/cpuinfo",
      "//third_party/pthreadpool",
      "//third_party/xnnpack",
    ]
  }
}
